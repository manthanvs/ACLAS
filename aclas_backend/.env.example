# ACLAS environment variable template
# Copy to .env and fill in real values. Never commit .env to Git.

# Django secret key – generate a new one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-secret-key-here

# ---- Production only (leave unset for local dev) ----
# DJANGO_DEBUG=0
# DJANGO_ALLOWED_HOSTS=yourname.pythonanywhere.com
# DJANGO_CSRF_ORIGINS=https://yourname.pythonanywhere.com
# DJANGO_SITE_ID=1
